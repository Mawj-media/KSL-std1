# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Clerk (https://dashboard.clerk.com -> API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Supabase (https://supabase.com/dashboard -> Project Settings -> API) ---
# URL: Project Settings -> API -> Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# SERVICE ROLE key (NOT the anon key - it bypasses RLS, server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Clerk webhook (https://dashboard.clerk.com -> Webhooks -> Add Endpoint) ---
# Endpoint URL: https://<your-domain>/api/webhooks/clerk
# Events: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SECRET=whsec_...